{
  "version": "1",
  "auth": {
    "user_pool_id": "us-east-1_EXAMPLE",
    "aws_region": "us-east-1",
    "user_pool_client_id": "example",
    "identity_pool_id": "us-east-1:example",
    "mfa_methods": [],
    "standard_required_attributes": ["email"],
    "username_attributes": ["email"],
    "user_verification_types": ["email"],
    "password_policy": {
      "min_length": 8,
      "require_lowercase": true,
      "require_uppercase": true,
      "require_numbers": true,
      "require_symbols": true
    },
    "unauthenticated_identities_enabled": true
  },
  "data": {
    "url": "https://example.appsync-api.us-east-1.amazonaws.com/graphql",
    "aws_region": "us-east-1",
    "api_key": "da2-example",
    "default_authorization_type": "API_KEY",
    "authorization_types": ["API_KEY", "AWS_IAM", "AMAZON_COGNITO_USER_POOLS"]
  },
  "storage": {
    "aws_region": "us-east-1",
    "bucket_name": "memorial-storage-example"
  },
  "custom": {
    "memorialAssistantUrl": "https://example.lambda-url.us-east-1.on.aws/"
  }
}
